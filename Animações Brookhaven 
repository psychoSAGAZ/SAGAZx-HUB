local function SetVisualEquipped(subTypeName, assetId, packName, indicatorToActivate)
    local slot = ActiveSlots[subTypeName]
    if slot then
        slot.BackgroundColor3 = Color3.fromRGB(46, 117, 89)
        slot.Image.Image = "rbxthumb://type=Asset&id=" .. tostring(assetId) .. "&w=150&h=150"
        slot.Label.Text = subTypeName .. "\n[" .. packName .. "]"
        slot.Label.TextColor3 = Color3.fromRGB(255, 255, 255)
        slot.CloseBtn.Visible = true
    end
    if ActiveIndicators[subTypeName] then ActiveIndicators[subTypeName].Visible = false end
    if indicatorToActivate then
        indicatorToActivate.Visible = true
        ActiveIndicators[subTypeName] = indicatorToActivate
    end
    CurrentEquippedIds[subTypeName] = tostring(assetId)
end

local function EquipSubAnimation(assetId, subTypeName, packName, buttonIndicator, bypassSafety)
    if not assetId or assetId == 0 then return end
    assetId = tostring(assetId)

    if CurrentEquippedIds[subTypeName] == assetId then
        if not bypassSafety then
            UnequipSubAnimation(subTypeName)
        end
        return
    end

    pcall(function()
        local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
        if remotes and remotes:FindFirstChild("Wear") then 
            remotes.Wear:InvokeServer(tonumber(assetId)) 
        end
    end)
    SetVisualEquipped(subTypeName, assetId, packName, buttonIndicator) 
end

