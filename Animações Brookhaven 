local function ClearVisualSlot(subTypeName)
    local slot = ActiveSlots[subTypeName]
    if slot then
        slot.BackgroundColor3 = Color3.fromRGB(38, 38, 48)
        slot.Image.Image = ""
        slot.Label.Text = subTypeName .. "\n[Nenhum]"
        slot.Label.TextColor3 = Color3.fromRGB(150, 150, 160)
        slot.CloseBtn.Visible = false
    end
    if ActiveIndicators[subTypeName] then
        ActiveIndicators[subTypeName].Visible = false
    end
    CurrentEquippedIds[subTypeName] = nil
end

local function UnequipSubAnimation(subTypeName)
    local targetId = CurrentEquippedIds[subTypeName]
    if not targetId then return end
    
    pcall(function()
        local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
        if remotes and remotes:FindFirstChild("Wear") then
            remotes.Wear:InvokeServer(tonumber(targetId))
        end
    end)
    ClearVisualSlot(subTypeName)
end

