local function DiscoverAndApplyActiveAnimations()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local animateScript = char:WaitForChild("Animate", 5)
    if not animateScript then return end

    local mapping = {
        ["idle"] = "Idle", ["walk"] = "Walk", ["run"] = "Run",
        ["jump"] = "Jump", ["fall"] = "Fall", ["climb"] = "Climb", ["swim"] = "Swim"
    }

    for folderName, typeName in pairs(mapping) do
        local folder = animateScript:FindFirstChild(folderName)
        if folder then
            local foundAnimObj = folder:FindFirstChildOfClass("Animation")
            if foundAnimObj and foundAnimObj.AnimationId ~= "" then
                local currentIdStr = string.match(foundAnimObj.AnimationId, "%d+")
                if currentIdStr then
                    local foundPackName = "Atual"
                    local foundIndicator = nil

                    for _, pack in ipairs(animationData) do
                        if pack.bundledItems and pack.bundledItems[typeName] and tostring(pack.bundledItems[typeName]) == currentIdStr then
                            foundPackName = pack.name
                            break
                        end
                    end
                    
                    if GlobalSubButtons[currentIdStr] then
                        foundIndicator = GlobalSubButtons[currentIdStr].indicator
                    end

                    SetVisualEquipped(typeName, currentIdStr, foundPackName, foundIndicator)
                end
            end
        end
    end
end

task.spawn(function()
    DiscoverAndApplyActiveAnimations()
    while not listGenerationComplete do task.wait(0.5) end
    DiscoverAndApplyActiveAnimations()
end)

