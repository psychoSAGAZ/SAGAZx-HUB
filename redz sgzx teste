            BorderSizePixel = 0,
            Name = "SliderFill"
        })
        Make("Corner", sliderFill, UDim.new(1, 0))

        local sliderKnob = Create("Frame", sliderBar, {
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(initialValue, -7, 0.5, -7),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0,
            Name = "SliderKnob"
        })
        Make("Corner", sliderKnob, UDim.new(1, 0))

        local dragging = false

        local function update(input)
            local absPos = sliderBar.AbsolutePosition
            local absSize = sliderBar.AbsoluteSize
            local mouseX = math.clamp(input.Position.X - absPos.X, 0, absSize.X)
            
            local alpha = mouseX / absSize.X
            sliderFill.Size = UDim2.new(alpha, 0, 1, 0)
            sliderKnob.Position = UDim2.new(alpha, -7, 0.5, -7)
            sliderValueLabel.Text = math.round(alpha * 100) .. "%"
            
            MyLibrary.Save[saveKey] = alpha
            if callback then callback(alpha) end
        end

        sliderBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(input)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                SaveLibrary()
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
                update(input)
            end
        end)
    end

