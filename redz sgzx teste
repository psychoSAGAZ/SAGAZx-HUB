-- Função para encontrar e fazer backup das bordas
local function findAndBackupBorders()
    borderColorBackup = {}
    
    local coreGui = game:GetService("CoreGui")
    local hubContainer = nil
    
    for _, child in ipairs(coreGui:GetChildren()) do
        if child.Name:find("SAGAZX HUB") or child.Name:find("SAGAZx HUB") then
            hubContainer = child
            break
        end
    end
    
    if hubContainer then
        local hub = hubContainer:FindFirstChild("Hub")
        if hub then
            local function searchForBorders(parent)
                for _, child in ipairs(parent:GetDescendants()) do
                    if child.Name == "LibBorder" then
                        if child:IsA("UIStroke") then
                            borderColorBackup[child] = child.Color
                        elseif child:IsA("Frame") then
                            local stroke = child:FindFirstChild("UIStroke")
                            if stroke then
                                borderColorBackup[stroke] = stroke.Color
                            end
                        end
                    end
                end
            end
            
            searchForBorders(hub)
        end
    end
    
    local function searchInCoreGui()
        for _, child in ipairs(coreGui:GetDescendants()) do
            if child.Name == "LibBorder" then
                if child:IsA("UIStroke") then
                    borderColorBackup[child] = child.Color
                elseif child:IsA("Frame") then
                    local stroke = child:FindFirstChild("UIStroke")
                    if stroke then
                        borderColorBackup[stroke] = stroke.Color
                    end
                end
            end
        end
    end
    
    searchInCoreGui()
end

local function updatePickerVisuals()
    local pureColor = Color3.fromHSV(currentHue, currentSat, 1)
    ValueGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
        ColorSequenceKeypoint.new(1, pureColor)
    })
    
    previewColor = Color3.fromHSV(currentHue, currentSat, currentVal)
    OkButton.BackgroundColor3 = previewColor
    
    local brightness = (previewColor.R * 0.299) + (previewColor.G * 0.587) + (previewColor.B * 0.114)
    if brightness > 0.5 then
        OkButton.TextColor3 = Color3.fromRGB(20, 20, 20)
    else
        OkButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end

local draggingMap = false
