local function createTransparencySlider(parentScroll, sliderTitle, initialValue, callback)
    local sliderContainer = Instance.new("Frame")
    local sliderContainerCorner = Instance.new("UICorner")

    local sliderTitleLabel = Instance.new("TextLabel")
    local sliderValueLabel = Instance.new("TextLabel")

    local sliderBar = Instance.new("Frame")
    local sliderBarCorner = Instance.new("UICorner")

    local sliderFill = Instance.new("Frame")
    local sliderFillCorner = Instance.new("UICorner")

    local sliderKnob = Instance.new("Frame")
    local knobCorner = Instance.new("UICorner")

    sliderContainer.Name = sliderTitle .. "_Container"
    sliderContainer.Parent = parentScroll
    sliderContainer.Size = UDim2.new(1, 0, 0, 56)
    sliderContainer.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
    sliderContainer.BorderSizePixel = 0

    sliderContainerCorner.CornerRadius = UDim.new(0, 6)
    sliderContainerCorner.Parent = sliderContainer

    sliderTitleLabel.Name = "TitleLabel"
    sliderTitleLabel.Parent = sliderContainer
    sliderTitleLabel.Size = UDim2.new(1, -50, 0, 18)
    sliderTitleLabel.Position = UDim2.new(0, 6, 0, 4)
    sliderTitleLabel.BackgroundTransparency = 1
    sliderTitleLabel.Text = sliderTitle
    sliderTitleLabel.TextColor3 = Color3.fromRGB(200, 200, 220)
    sliderTitleLabel.TextSize = 10
    sliderTitleLabel.Font = Enum.Font.GothamBold
    sliderTitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    sliderValueLabel.Name = "ValueLabel"
    sliderValueLabel.Parent = sliderContainer
    sliderValueLabel.Size = UDim2.new(0, 40, 0, 18)
    sliderValueLabel.Position = UDim2.new(1, -46, 0, 4)
    sliderValueLabel.BackgroundTransparency = 1
    sliderValueLabel.Text = math.round(initialValue * 100) .. "%"
    sliderValueLabel.TextColor3 = Color3.fromRGB(0, 180, 255)
    sliderValueLabel.TextSize = 10
    sliderValueLabel.Font = Enum.Font.GothamBold
    sliderValueLabel.TextXAlignment = Enum.TextXAlignment.Right

    sliderBar.Name = "SliderBar"
    sliderBar.Parent = sliderContainer
    sliderBar.Size = UDim2.new(1, -16, 0, 8)
    sliderBar.Position = UDim2.new(0, 8, 0, 30)
    sliderBar.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    sliderBar.BorderSizePixel = 0

    sliderBarCorner.CornerRadius = UDim.new(1, 0)
    sliderBarCorner.Parent = sliderBar

    sliderFill.Name = "SliderFill"
    sliderFill.Parent = sliderBar
    sliderFill.Size = UDim2.new(initialValue, 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
    sliderFill.BorderSizePixel = 0

    sliderFillCorner.CornerRadius = UDim.new(1, 0)
    sliderFillCorner.Parent = sliderFill

    sliderKnob.Name = "SliderKnob"
    sliderKnob.Parent = sliderBar
    sliderKnob.Size = UDim2.new(0, 14, 0, 14)
    sliderKnob.Position = UDim2.new(initialValue, -7, 0.5, -7)
    sliderKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    sliderKnob.BorderSizePixel = 0

    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = sliderKnob

    local dragging = false

    local function update(input)
        local absPos = sliderBar.AbsolutePosition
        local absSize = sliderBar.AbsoluteSize
        local mouseX = math.clamp(input.Position.X - absPos.X, 0, absSize.X)
        
        local alpha = mouseX / absSize.X
        sliderFill.Size = UDim2.new(alpha, 0, 1, 0)
        sliderKnob.Position = UDim2.new(alpha, -7, 0.5, -7)
        sliderValueLabel.Text = math.round(alpha * 100) .. "%"
        
        if callback then callback(alpha) end
    end

    sliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)

    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
            update(input)
        end
    end)
end

