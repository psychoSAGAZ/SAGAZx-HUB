local draggingSpeed = false
local animSpeed = 1

local function updateSpeedSlider(input)
    local absPos = speedBar.AbsolutePosition
    local absSize = speedBar.AbsoluteSize
    local mouseX = math.clamp(input.Position.X - absPos.X, 0, absSize.X)
    local alpha = mouseX / absSize.X
    animSpeed = math.round((alpha * 4.9 + 0.1) * 10) / 10
    
    speedFill.Size = UDim2.new(alpha, 0, 1, 0)
    speedKnob.Position = UDim2.new(alpha, -7, 0.5, -7)
    speedValue.Text = animSpeed .. "x"
end

speedBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSpeed = true
        updateSpeedSlider(input)
    end
end)

game:GetService("UserInputService").InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSpeed = false
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and draggingSpeed then
        updateSpeedSlider(input)
    end
end)

