-- Funções auxiliares para cores (hex <-> Color3)
local function Color3ToHex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
end

local function HexToColor3(hex)
    if type(hex) ~= "string" then return Color3.new(1,1,1) end
    hex = hex:gsub("#", "")
    if #hex ~= 6 then return Color3.new(1,1,1) end
    local r = tonumber(hex:sub(1,2), 16) / 255
    local g = tonumber(hex:sub(3,4), 16) / 255
    local b = tonumber(hex:sub(5,6), 16) / 255
    if not r or not g or not b then return Color3.new(1,1,1) end
    return Color3.new(r, g, b)
end

-- Converte as cores de um tema (tabela) de hex para Color3, se necessário
local function ConvertThemeColors(theme)
    local result = {}
    for k, v in pairs(theme) do
        if k == "Color Hub 1" then
            -- assumir ColorSequence ou string
            if typeof(v) == "ColorSequence" then
                result[k] = v
            else
                -- converter de hex para ColorSequence (não vamos usar isso para temas salvos, mas para segurança)
                -- Aqui simplesmente mantemos a estrutura original dos temas definidos
                result[k] = v
            end
        else
            if type(v) == "string" and v:sub(1,1) == "#" then
                result[k] = HexToColor3(v)
            else
                result[k] = v
            end
        end
    end
    return result
end

-- Função para obter o tema atual (considerando temas personalizados)
function MyLibrary:GetCurrentTheme()
    if self.Save.Theme == "Custom" then
        -- Se houver um tema personalizado nomeado e salvo, use-o
        if self.Save.CustomThemeName and self.Save.SavedThemes[self.Save.CustomThemeName] then
            return ConvertThemeColors(self.Save.SavedThemes[self.Save.CustomThemeName])
        end
        -- Caso contrário, use as cores personalizadas da aba de cores
        local colors = self.Save.CustomColors
        local c1 = HexToColor3(colors.Color1)
        local c2 = HexToColor3(colors.Color2)
        local c3 = HexToColor3(colors.Color3)
        local c4 = HexToColor3(colors.Color4)
        local c5 = HexToColor3(colors.Color5)
        local c6 = HexToColor3(colors.Color6)
        local c7 = HexToColor3(colors.Color7)
        local c8 = HexToColor3(colors.Color8)
        return {
            ["Color Hub 1"] = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, c1),
                ColorSequenceKeypoint.new(0.50, c2),
                ColorSequenceKeypoint.new(1.00, c3)
            }),
            ["Color Hub 2"] = c4,
            ["Color Stroke"] = c5,
            ["Color Theme"] = c6,
            ["Color Text"] = c7,
            ["Color Dark Text"] = c8
        }
    end
    -- Se não for Custom, retorna o tema padrão
    return self.Themes[self.Save.Theme] or self.Themes.Purple
end

-- Função para salvar as configurações no arquivo
local function SaveConfig()
    if not writefile then return end
    local data = {}
    for k, v in pairs(MyLibrary.Save) do
        if k == "CustomColors" then
            data[k] = {}
            for ck, cv in pairs(v) do
                if type(cv) == "string" and cv:sub(1,1) == "#" then
                    data[k][ck] = cv
                else
                    data[k][ck] = Color3ToHex(cv)
                end
            end
        elseif k == "SavedThemes" then
            data[k] = {}
            for themeName, themeData in pairs(v) do
                data[k][themeName] = {}
                for tk, tv in pairs(themeData) do
                    if type(tv) == "string" and tv:sub(1,1) == "#" then
                        data[k][themeName][tk] = tv
                    elseif typeof(tv) == "ColorSequence" then
                        -- ColorSequence não pode ser salvo; ignorar ou tratar
                        -- Para simplicidade, convertemos para hex dos keypoints
                        local kps = tv.Keypoints
                        if #kps >= 3 then
                            data[k][themeName][tk] = {
                                kp1 = Color3ToHex(kps[1].Value),
                                kp2 = Color3ToHex(kps[2].Value),
                                kp3 = Color3ToHex(kps[3].Value)
                            }
                        end
                    else
                        data[k][themeName][tk] = tv
                    end
                end
            end
        else
            data[k] = v
        end
    end
    local json = HttpService:JSONEncode(data)
    pcall(writefile, "SAGAZx HUB lib.json", json)
end

-- Função para carregar configurações do arquivo
local function LoadConfig()
    if not isfile or not readfile then return end
    local file = "SAGAZx HUB lib.json"
    if not isfile(file) then return end
    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(file))
    end)
    if not success or type(data) ~= "table" then return end
    for k, v in pairs(data) do
        if MyLibrary.Save[k] ~= nil then
            MyLibrary.Save[k] = v
        end
    end
    -- Converter cores de hex para Color3 no CustomColors (se já não estiverem)
    if MyLibrary.Save.CustomColors then
        for ck, cv in pairs(MyLibrary.Save.CustomColors) do
            if type(cv) == "string" and cv:sub(1,1) == "#" then
                MyLibrary.Save.CustomColors[ck] = cv -- manter como string para salvar depois; usaremos HexToColor3 quando necessário
            end
        end
    end
    -- Converter SavedThemes: cada chave de cor pode ser string ou tabela (para ColorSequence)
    if MyLibrary.Save.SavedThemes then
        for themeName, themeData in pairs(MyLibrary.Save.SavedThemes) do
            for tk, tv in pairs(themeData) do
                if type(tv) == "string" and tv:sub(1,1) == "#" then
                    themeData[tk] = tv -- manter string
                elseif type(tv) == "table" then
                    -- se for tabela de keypoints, converte para ColorSequence
                    if tv.kp1 and tv.kp2 and tv.kp3 then
                        themeData[tk] = ColorSequence.new({
                            ColorSequenceKeypoint.new(0.00, HexToColor3(tv.kp1)),
                            ColorSequenceKeypoint.new(0.50, HexToColor3(tv.kp2)),
                            ColorSequenceKeypoint.new(1.00, HexToColor3(tv.kp3))
                        })
                    end
                end
            end
        end
    end
end

