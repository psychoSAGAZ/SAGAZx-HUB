                    end
                end
            end
            function Dropdown:Select(Option)
                if type(Option) == "string" then
                    for _, Val in pairs(GetOptions()) do
                        if Val.Name == Option then Select(Val) end
                    end
                elseif type(Option) == "number" then
                    for _, Val in pairs(GetOptions()) do
                        if Val.index == Option then Select(Val) end
                    end
                end
            end
