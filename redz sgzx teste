    local arrowIcon = Instance.new("TextLabel")

    local optionsFrame = Instance.new("Frame")
    local optionsLayout = Instance.new("UIListLayout")

    container.Name = titleText .. "_Dropdown"
    container.Parent = parentScroll
    container.Size = UDim2.new(1, 0, 0, 38)
    container.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
    container.BorderSizePixel = 0
    container.ClipsDescendants = true

    containerCorner.CornerRadius = UDim.new(0, 6)
    containerCorner.Parent = container

    headerButton.Name = "HeaderButton"
    headerButton.Parent = container
    headerButton.Size = UDim2.new(1, 0, 0, 38)
    headerButton.BackgroundTransparency = 1
    headerButton.Text = ""

    titleLabel.Name = "TitleLabel"
    titleLabel.Parent = headerButton
    titleLabel.Size = UDim2.new(1, -110, 0, 16)
    titleLabel.Position = UDim2.new(0, 8, 0, 4)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = titleText
    titleLabel.TextColor3 = Color3.fromRGB(200, 200, 220)
    titleLabel.TextSize = 10
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left

    selectedLabel.Name = "SelectedLabel"
    selectedLabel.Parent = headerButton
    selectedLabel.Size = UDim2.new(1, -30, 0, 14)
    selectedLabel.Position = UDim2.new(0, 8, 0, 20)
    selectedLabel.BackgroundTransparency = 1
    selectedLabel.Text = options[1] or "Nenhum"
    selectedLabel.TextColor3 = Color3.fromRGB(0, 180, 255)
    selectedLabel.TextSize = 10
    selectedLabel.Font = Enum.Font.GothamSemibold
    selectedLabel.TextXAlignment = Enum.TextXAlignment.Left

    arrowIcon.Name = "Arrow"
    arrowIcon.Parent = headerButton
    arrowIcon.Size = UDim2.new(0, 20, 0, 20)
    arrowIcon.Position = UDim2.new(1, -24, 0.5, -10)
    arrowIcon.BackgroundTransparency = 1
    arrowIcon.Text = "v"
    arrowIcon.TextColor3 = Color3.fromRGB(150, 150, 170)
    arrowIcon.TextSize = 12
    arrowIcon.Font = Enum.Font.GothamBold

    optionsFrame.Name = "OptionsFrame"
    optionsFrame.Parent = container
    optionsFrame.Size = UDim2.new(1, -12, 0, 0)
    optionsFrame.Position = UDim2.new(0, 6, 0, 38)
    optionsFrame.BackgroundTransparency = 1

    optionsLayout.Parent = optionsFrame
    optionsLayout.SortOrder = Enum.SortOrder.LayoutOrder
    optionsLayout.Padding = UDim.new(0, 3)

    local isOpen = false

    local function toggleDropdown()
        isOpen = not isOpen
        local targetHeight = 38
        if isOpen then
            targetHeight = 38 + optionsLayout.AbsoluteContentSize.Y + 6
            arrowIcon.Text = "^"
        else
            arrowIcon.Text = "v"
        end
        container.Size = UDim2.new(1, 0, 0, targetHeight)
    end

    headerButton.MouseButton1Click:Connect(toggleDropdown)

    local function addOptionButton(optText)
        local optBtn = Instance.new("TextButton")
        local optCorner = Instance.new("UICorner")

        optBtn.Name = optText .. "_Opt"
        optBtn.Parent = optionsFrame
        optBtn.Size = UDim2.new(1, 0, 0, 22)
        optBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
        optBtn.Text = "  " .. optText
        optBtn.TextColor3 = Color3.fromRGB(180, 180, 200)
        optBtn.TextSize = 10
        optBtn.Font = Enum.Font.GothamSemibold
        optBtn.TextXAlignment = Enum.TextXAlignment.Left
        optBtn.BorderSizePixel = 0

        optCorner.CornerRadius = UDim.new(0, 4)
        optCorner.Parent = optBtn

        optBtn.MouseButton1Click:Connect(function()
            selectedLabel.Text = optText
            toggleDropdown()
            if callback then callback(optText) end
        end)
    end

    for _, optText in ipairs(options) do
        addOptionButton(optText)
    end

    optionsLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        if isOpen then
            container.Size = UDim2.new(1, 0, 0, 38 + optionsLayout.AbsoluteContentSize.Y + 6)
        end
    end)

    dropdownData.Container = container
    dropdownData.getSelectedText = function() return selectedLabel.Text end
    dropdownData.addOption = function(optText) addOptionButton(optText) end

    table.insert(allDropdowns, dropdownData)
    return dropdownData
end

