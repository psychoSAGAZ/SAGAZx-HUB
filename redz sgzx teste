-- Slider de transparência
local function createSlider(parent, title, saveKey, callback)
    local section = createConfigSection(parent, title)
    section.Size = UDim2.new(1, 0, 0, 50)
    
    local valueLabel = Create("TextLabel", section, {
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -50, 0, 5),
        Text = "0%",
        TextColor3 = Color3.fromRGB(0, 180, 255),
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Right
    })
    
    local sliderBar = Create("TextButton", section, {
        Size = UDim2.new(1, -20, 0, 10),
        Position = UDim2.new(0, 10, 0, 30),
        BackgroundColor3 = Color3.fromRGB(20, 20, 25),
        Text = "",
        AutoButtonColor = false
    })
    MakeCorner(sliderBar, UDim.new(1, 0))
    
    local sliderFill = Create("Frame", sliderBar, {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(0, 120, 215)
    })
    MakeCorner(sliderFill, UDim.new(1, 0))
    
    local function updateSlider(input)
        local mouseX = input.Position.X - sliderBar.AbsolutePosition.X
        local alpha = math.clamp(mouseX / sliderBar.AbsoluteSize.X, 0, 1)
        
        sliderFill.Size = UDim2.new(alpha, 0, 1, 0)
        valueLabel.Text = math.round(alpha * 100) .. "%"
        
        MyLibrary.Save[saveKey] = alpha
        if callback then callback(alpha) end
    end
    
    sliderBar.MouseButton1Down:Connect(function()
        local connection
        connection = UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                updateSlider(input)
            end
        end)
        
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                connection:Disconnect()
                SaveLibrary()
            end
        end)
    end)
end

