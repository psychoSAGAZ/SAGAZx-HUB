UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if keybindBox.IsFocused then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            selectedKey = input.KeyCode
            keybindBox.Text = input.KeyCode.Name
            MyLibrary.Save.Keybind = input.KeyCode.Name
            SaveLibrary()
            keybindBox:ReleaseFocus()
        end
    else
        if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == selectedKey then
            MainFrame.Visible = not MainFrame.Visible
        end
    end
end)

