local fontButtons = {}

local function applyGlobalFont(newFontEnum)
    for _, descendant in ipairs(MainFrame:GetDescendants()) do
        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
            local isFontDemoButton = false
            for _, item in ipairs(fontButtons) do
                if item.Button == descendant then
                    isFontDemoButton = true
                    break
                end
            end
            if not isFontDemoButton then
                descendant.Font = newFontEnum
            end
        end
    end
end

for index, fontData in ipairs(fontList) do
    local fBtn = Instance.new("TextButton")
    local fCorner = Instance.new("UICorner")

    fBtn.Name = fontData.Name .. "_Btn"
    fBtn.Parent = fontesScroll
    if index == 1 then
        fBtn.BackgroundColor3 = COLOR_ACTIVE
        fBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        fBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
        fBtn.TextColor3 = Color3.fromRGB(220, 220, 230)
    end
    fBtn.Text = fontData.Name
    fBtn.TextSize = 10
    fBtn.Font = fontData.FontEnum
    fBtn.BorderSizePixel = 0

    fCorner.CornerRadius = UDim.new(0, 6)
    fCorner.Parent = fBtn

    table.insert(fontButtons, {Button = fBtn, FontEnum = fontData.FontEnum})

    fBtn.MouseButton1Click:Connect(function()
        for _, item in ipairs(fontButtons) do
            if item.Button == fBtn then
                item.Button.BackgroundColor3 = COLOR_ACTIVE
                item.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                item.Button.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
                item.Button.TextColor3 = Color3.fromRGB(220, 220, 230)
            end
        end
        applyGlobalFont(fontData.FontEnum)
        
        -- Chamada para a Library
        if MyLibrary and MyLibrary.SetFont then
            MyLibrary:SetFont(fontData.FontEnum)
        end
    end)
end

