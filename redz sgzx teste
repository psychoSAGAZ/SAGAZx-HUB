                            item.nodes[1].Visible = true
                        else
                            item.nodes[1].Visible = false
                        end
                    end
                    CalculateSize(true)
                end)
                for k, v in pairs(DOptions) do AddOption(k, v) end
                CallbackSelected()
                UpdateSelected()
            end

