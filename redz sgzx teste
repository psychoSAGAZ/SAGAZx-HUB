-- Motor de execução dos efeitos (manter como está)
local RunService = game:GetService("RunService")

RunService.RenderStepped:Connect(function(dt)
    if not rgbEffectActive and not customEffectActive then return end
    
    local timeElapsed = tick() * animSpeed
    local effectOpt = dropdownEffect.getSelectedText()
    
    local baseColor
    if rgbEffectActive then
        baseColor = Color3.fromHSV((timeElapsed % 5) / 5, 1, 1)
    elseif customEffectActive then
        baseColor = customEffectColor
    end
    
    if not baseColor then return end
    
    if effectOpt == "Girar Gradiente" then
        if rgbEffectActive then
            applyBorderColor(baseColor)
        else
            local h, s, v = baseColor:ToHSV()
            local shiftedHue = (h + (math.sin(timeElapsed * 2) * 0.1)) % 1
            applyBorderColor(Color3.fromHSV(shiftedHue, s, v))
        end
        
    elseif effectOpt == "Pulsar Brilho" then
        local brightness = 0.5 + (math.sin(timeElapsed * 4) * 0.5)
        local h, s, v = baseColor:ToHSV()
        applyBorderColor(Color3.fromHSV(h, s, math.clamp(v * brightness, 0, 1)))
        
    elseif effectOpt == "Onda Fluida" then
        local h, s, v = baseColor:ToHSV()
        local waveVal = math.clamp(v * (0.5 + 0.5 * math.sin(timeElapsed * 3)), 0.2, 1)
        applyBorderColor(Color3.fromHSV(h, s, waveVal))
        
    elseif effectOpt == "Neon Strobe" then
        if math.floor(timeElapsed * 6 * animSpeed) % 2 == 0 then
            applyBorderColor(baseColor)
        else
            applyBorderColor(Color3.fromRGB(30, 30, 35))
        end
        
    elseif effectOpt == "Fade Suave" then
        local h, s, v = baseColor:ToHSV()
        local fadeFactor = 0.3 + 0.7 * math.abs(math.sin(timeElapsed * 1.5))
        applyBorderColor(Color3.fromHSV(h, s, fadeFactor))
    end
end)

