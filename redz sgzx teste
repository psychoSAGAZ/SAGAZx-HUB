end)

customColorHex.Focused:Connect(function() 
    customColorHexStroke.Color = Color3.fromRGB(0, 120, 215) 
end)

customColorRGB.FocusLost:Connect(function()
    customColorRGBStroke.Color = Color3.fromRGB(55, 55, 70)
    local r, g, b = customColorRGB.Text:match("(%d+),%s*(%d+),%s*(%d+)")
    if r and g and b then
        r = math.clamp(tonumber(r), 0, 255)
        g = math.clamp(tonumber(g), 0, 255)
        b = math.clamp(tonumber(b), 0, 255)
        
        local newColor = Color3.fromRGB(r, g, b)
        updateCustomColor(newColor)
    else
        local cur = customEffectColor
        customColorRGB.Text = math.round(cur.R*255) .. ", " .. math.round(cur.G*255) .. ", " .. math.round(cur.B*255)
    end
end)

customColorHex.FocusLost:Connect(function()
    customColorHexStroke.Color = Color3.fromRGB(55, 55, 70)
    local hexText = customColorHex.Text:gsub("#", "")
    if #hexText == 6 and tonumber(hexText, 16) then
        local success, newColor = pcall(function()
            return Color3.fromHex(hexText)
        end)
        if success and newColor then
            customColorHex.Text = "#" .. hexText:upper()
            updateCustomColor(newColor)
        end
    else
        customColorHex.Text = colorToHex(customEffectColor)
        customColorHex.TextColor3 = customEffectColor
    end
end)

