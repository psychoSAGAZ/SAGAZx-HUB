-- Função para atualizar a cor personalizada
local function updateCustomColor(newColor)
    customEffectColor = newColor
    customColorBtn.BackgroundColor3 = newColor
    
    local r = math.round(newColor.R * 255)
    local g = math.round(newColor.G * 255)
    local b = math.round(newColor.B * 255)
    customColorRGB.Text = r .. ", " .. g .. ", " .. b
    customColorHex.Text = colorToHex(newColor)
    customColorHex.TextColor3 = newColor
    
    -- Se o efeito personalizado estiver ativo, aplicar imediatamente
    if customEffectActive then
        applyBorderColor(newColor)
    end
end

