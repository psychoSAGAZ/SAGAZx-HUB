        rgbStroke.Color = Color3.fromRGB(55, 55, 70)
        local r, g, b = rgbBox.Text:match("(%d+),%s*(%d+),%s*(%d+)")
        if r and g and b then
            r = math.clamp(tonumber(r), 0, 255)
            g = math.clamp(tonumber(g), 0, 255)
            b = math.clamp(tonumber(b), 0, 255)
            
            local newColor = Color3.fromRGB(r, g, b)
            colorBtn.BackgroundColor3 = newColor
            
            rgbBox.Text = r .. ", " .. g .. ", " .. b
            hexBox.Text = colorToHex(newColor)
            hexBox.TextColor3 = newColor
            
            -- Aplicar a cor ao tema
            applyThemeColor(colorKey, newColor)
        else
            local cur = colorBtn.BackgroundColor3
            rgbBox.Text = math.round(cur.R*255) .. ", " .. math.round(cur.G*255) .. ", " .. math.round(cur.B*255)
            hexBox.Text = colorToHex(cur)
            hexBox.TextColor3 = cur
        end
    end)
    
    return {
        ColorBtn = colorBtn,
        RGBBox = rgbBox,
        HexBox = hexBox
    }
end

