-- Mapeamento Inverso (Inglês -> Português)
local reverseTranslationTable = {}
for pt, en in pairs(translationTable) do
    reverseTranslationTable[en] = pt
end

local function trim(s)
    return s:match("^%s*(.-)%s*$")
end

