local function updateMapInput(input)
    local absPos = ColorMap.AbsolutePosition
    local absSize = ColorMap.AbsoluteSize
    local mouseX = math.clamp(input.Position.X - absPos.X, 0, absSize.X)
    local mouseY = math.clamp(input.Position.Y - absPos.Y, 0, absSize.Y)
    
    currentHue = mouseX / absSize.X
    currentSat = 1 - (mouseY / absSize.Y)
    
    MapPointer.Position = UDim2.new(0, mouseX - 4, 0, mouseY - 4)
    updatePickerVisuals()
end

local function updateSliderInput(input)
    local absPos = ValueSliderFrame.AbsolutePosition
    local absSize = ValueSliderFrame.AbsoluteSize
    local mouseX = math.clamp(input.Position.X - absPos.X, 0, absSize.X)
    
    currentVal = mouseX / absSize.X
    ValuePointer.Position = UDim2.new(0, mouseX - 4, 0.5, -9)
    updatePickerVisuals()
end

