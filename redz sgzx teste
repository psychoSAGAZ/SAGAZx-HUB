        MyLibrary.Save.RainbowToggleEnabled = state
        SaveJson("SAGAZx HUB lib.json", MyLibrary.Save)

        UpdateRainbowAppearance(state)
        task.spawn(Callback, state)

        if state then
            CreateTween({Ball, "Position", UDim2.new(1, 0, 0.5), 0.25})
            CreateTween({Ball, "AnchorPoint", Vector2.new(1, 0.5), 0.25, false})
        else
            CreateTween({Ball, "Position", UDim2.new(0, 0, 0.5), 0.25})
            CreateTween({Ball, "AnchorPoint", Vector2.new(0, 0.5), 0.25, false})
        end

        WaitClick = false
    end

    -- Aplica estado inicial (sem animação de movimento brusca)
