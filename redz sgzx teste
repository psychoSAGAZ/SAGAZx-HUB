local function SaveLibrary()
    if writefile then
        pcall(function()
            writefile("SAGAZx HUB lib.json", HttpService:JSONEncode(MyLibrary.Save))
        end)
    end
end

local function LoadLibrary()
    if readfile and isfile and isfile("SAGAZx HUB lib.json") then
        pcall(function()
            local decoded = HttpService:JSONDecode(readfile("SAGAZx HUB lib.json"))
            for k, v in pairs(decoded) do
                MyLibrary.Save[k] = v
            end
        end)
    end
end

