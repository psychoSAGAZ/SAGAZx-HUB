            local success, newColor = pcall(function()
                return Color3.fromHex(hexText)
            end)
            if success and newColor then
                colorBtn.BackgroundColor3 = newColor
                
                local r = math.round(newColor.R * 255)
                local g = math.round(newColor.G * 255)
                local b = math.round(newColor.B * 255)
