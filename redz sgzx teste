local SetProps, SetChildren, InsertTheme, Create do
    InsertTheme = function(Instance, Type)
        table.insert(MyLibrary.Instances, {
            Instance = Instance,
            Type = Type
        })
        return Instance
    end

    SetChildren = function(Instance, Children)
        if Children then
            table.foreach(Children, function(_, Child)
                Child.Parent = Instance
            end)
        end
        return Instance
    end

    SetProps = function(Instance, Props)
        if Props then
            table.foreach(Props, function(prop, value)
                Instance[prop] = value
            end)
        end
        return Instance
    end

    Create = function(...)
        local args = {...}
        if #args < 1 then return end
        local new = Instance.new(args[1])
        if type(args[2]) == "table" then
            SetProps(new, args[2])
            SetChildren(new, args[3])
        elseif typeof(args[2]) == "Instance" then
            new.Parent = args[2]
            SetProps(new, args[3])
            SetChildren(new, args[4])
        end
        return new
    end
end

-- Carregar salvamento inicial
local function LoadInitialSave()
    local file = "SAGAZx HUB lib.json"
    if readfile and isfile and isfile(file) then
        local success, data = pcall(function() return HttpService:JSONDecode(readfile(file)) end)
        if success and type(data) == "table" then
            for key, value in pairs(data) do
                if MyLibrary.Save[key] ~= nil then
                    MyLibrary.Save[key] = value
                end
            end
            -- Converter cores hex para Color3
            if MyLibrary.Save.CustomColors then
                for i, v in pairs(MyLibrary.Save.CustomColors) do
                    if type(v) == "string" then
                        MyLibrary.Save.CustomColors[i] = HexToColor3(v)
                    end
                end
            end
            -- Converter temas salvos
            if MyLibrary.Save.SavedThemes then
                for themeName, themeData in pairs(MyLibrary.Save.SavedThemes) do
                    for colorKey, colorVal in pairs(themeData) do
                        if type(colorVal) == "string" and colorVal:sub(1,1) == "#" then
                            themeData[colorKey] = HexToColor3(colorVal)
                        end
