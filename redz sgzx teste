-- Animação de borda
local borderAnimationConnection = nil
local function StartBorderAnimation()
    if borderAnimationConnection then borderAnimationConnection:Disconnect() end
    if not MyLibrary.Save.BorderEnabled then return end
    borderAnimationConnection = RunService.RenderStepped:Connect(function(dt)
        local timeElapsed = tick() * 2
        local colorOpt = MyLibrary.Save.BorderColorOption
        local effectOpt = MyLibrary.Save.BorderEffectOption
        local baseColor
        if colorOpt == "RGB (Completo)" then
            baseColor = Color3.fromHSV((timeElapsed % 5) / 5, 1, 1)
        elseif colorOpt == "Vermelho" then baseColor = Color3.fromRGB(255,0,0)
        elseif colorOpt == "Laranja" then baseColor = Color3.fromRGB(255,128,0)
        elseif colorOpt == "Amarelo" then baseColor = Color3.fromRGB(255,255,0)
        elseif colorOpt == "Verde" then baseColor = Color3.fromRGB(0,255,0)
        elseif colorOpt == "Azul" then baseColor = Color3.fromRGB(0,0,255)
        elseif colorOpt == "Anil" then baseColor = Color3.fromRGB(75,0,130)
        elseif colorOpt == "Violeta" then baseColor = Color3.fromRGB(148,0,211)
        else baseColor = Color3.new(1,1,1) end

        if effectOpt == "Girar Gradiente" then
            MainStroke.Color = baseColor
            MainStroke.Thickness = 2
        elseif effectOpt == "Pulsar Brilho" then
            MainStroke.Color = baseColor
            MainStroke.Thickness = 2 + math.sin(timeElapsed * 4) * 1.5
        elseif effectOpt == "Onda Fluida" then
            local h,s,v = baseColor:ToHSV()
            MainStroke.Color = Color3.fromHSV(h, s, math.clamp(v * (0.5 + 0.5 * math.sin(timeElapsed * 3)), 0.2, 1))
            MainStroke.Thickness = 2.5
        elseif effectOpt == "Neon Strobe" then
            if math.floor(timeElapsed * 6) % 2 == 0 then
                MainStroke.Color = baseColor
                MainStroke.Thickness = 3
            else
                MainStroke.Color = Color3.fromRGB(30,30,35)
                MainStroke.Thickness = 1
            end
        elseif effectOpt == "Fade Suave" then
            local h,s,v = baseColor:ToHSV()
            MainStroke.Color = Color3.fromHSV(h, s, 0.3 + 0.7 * math.abs(math.sin(timeElapsed * 1.5)))
            MainStroke.Thickness = 2
        end
    end)
end

