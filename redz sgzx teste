-- Funções auxiliares de serialização de cor
local function Color3ToHex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
end

local function HexToColor3(hex)
    hex = hex:gsub("#", "")
    if #hex ~= 6 then return Color3.new(1,1,1) end
    local r = tonumber(hex:sub(1,2), 16) / 255
    local g = tonumber(hex:sub(3,4), 16) / 255
    local b = tonumber(hex:sub(5,6), 16) / 255
    return Color3.new(r, g, b)
end

-- Função para obter o tema atual (considerando personalizado)
function MyLibrary:GetCurrentTheme()
    if self.Save.Theme == "Custom" then
        -- Se houver tema personalizado nomeado, usa ele
        if self.Save.CustomThemeName and self.Save.SavedThemes[self.Save.CustomThemeName] then
            local saved = self.Save.SavedThemes[self.Save.CustomThemeName]
            return {
                ["Color Hub 1"] = ColorSequence.new({
                    ColorSequenceKeypoint.new(0.00, saved.Color1 or self.Save.CustomColors.Color1),
                    ColorSequenceKeypoint.new(0.50, saved.Color2 or self.Save.CustomColors.Color2),
                    ColorSequenceKeypoint.new(1.00, saved.Color3 or self.Save.CustomColors.Color3)
                }),
                ["Color Hub 2"] = saved.Color4 or self.Save.CustomColors.Color4,
                ["Color Stroke"] = saved.Color5 or self.Save.CustomColors.Color5,
                ["Color Theme"] = saved.Color6 or self.Save.CustomColors.Color6,
                ["Color Text"] = saved.Color7 or self.Save.CustomColors.Color7,
                ["Color Dark Text"] = saved.Color8 or self.Save.CustomColors.Color8
            }
        else
            -- Usa as CustomColors do Save
            return {
                ["Color Hub 1"] = ColorSequence.new({
                    ColorSequenceKeypoint.new(0.00, self.Save.CustomColors.Color1),
                    ColorSequenceKeypoint.new(0.50, self.Save.CustomColors.Color2),
                    ColorSequenceKeypoint.new(1.00, self.Save.CustomColors.Color3)
                }),
                ["Color Hub 2"] = self.Save.CustomColors.Color4,
                ["Color Stroke"] = self.Save.CustomColors.Color5,
                ["Color Theme"] = self.Save.CustomColors.Color6,
                ["Color Text"] = self.Save.CustomColors.Color7,
                ["Color Dark Text"] = self.Save.CustomColors.Color8
            }
        end
    end
    -- Tema padrão
    return self.Themes[self.Save.Theme]
end

