            if MyLibrary.Save.SoundEnabled then
                -- Tocar som
            end
            Callback()
        end)
        
        return {
            SetText = function(self, text)
                Button.Text = text
            end,
            Destroy = function()
                Button:Destroy()
            end
        }
    end
    
    function Tab:AddToggle(Configs)
        local TName = Configs[1] or Configs.Name or "Toggle"
        local Default = Configs[2] or Configs.Default or false
        local Callback = Configs[3] or Configs.Callback or function() end
        local Flag = Configs[4] or Configs.Flag or false
        
        if Flag and Flags[Flag] ~= nil then
            Default = Flags[Flag]
        end
        
        local ToggleFrame = Create("Frame", Container, {
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundColor3 = Theme["Color Hub 2"],
            BackgroundTransparency = MyLibrary.Save.ComponentsTransparency
        })
        MakeCorner(ToggleFrame)
        
        local Label = Create("TextLabel", ToggleFrame, {
            Position = UDim2.new(0, 10, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            Size = UDim2.new(1, -60, 0, 20),
            Text = TName,
            TextColor3 = Theme["Color Text"],
            TextSize = 10,
            Font = Enum.Font[MyLibrary.Save.SelectedFont] or Enum.Font.GothamBold,
            BackgroundTransparency = 1,
            TextXAlignment = Enum.TextXAlignment.Left
        })
        
        local ToggleButton = Create("TextButton", ToggleFrame, {
            Size = UDim2.new(0, 40, 0, 20),
            Position = UDim2.new(1, -50, 0.5, 0),
            AnchorPoint = Vector2.new(1, 0.5),
            BackgroundColor3 = Default and Theme["Color Theme"] or Theme["Color Stroke"],
            Text = "",
            AutoButtonColor = false
        })
        MakeCorner(ToggleButton, UDim.new(1, 0))
        
        local Indicator = Create("Frame", ToggleButton, {
            Size = UDim2.new(0, 16, 0, 16),
            Position = Default and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        })
        MakeCorner(Indicator, UDim.new(1, 0))
        
        local function SetToggle(val)
            Default = val
            if Flag then
                Flags[Flag] = val
            end
            Callback(val)
            
            if val then
                ToggleButton.BackgroundColor3 = Theme["Color Theme"]
                CreateTween(Indicator, "Position", UDim2.new(1, -18, 0.5, 0), 0.2)
            else
                ToggleButton.BackgroundColor3 = Theme["Color Stroke"]
                CreateTween(Indicator, "Position", UDim2.new(0, 2, 0.5, 0), 0.2)
            end
        end
        
        ToggleButton.MouseButton1Click:Connect(function()
            SetToggle(not Default)
        end)
        
        return {
            Set = function(self, val)
                SetToggle(val)
            end,
            Destroy = function()
                ToggleFrame:Destroy()
            end
        }
    end
    
    return Tab
end

