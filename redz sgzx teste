        Name = "RainbowBall"
    })
    Make("Corner", Ball, UDim.new(0.5, 0))

    -- Gradiente arco-íris (sem animação)
    local rainbowGradient = Create("UIGradient", Ball, {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),     -- vermelho
            ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 165, 0)), -- laranja
            ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 255, 0)), -- amarelo
            ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 0)),   -- verde
            ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 0, 255)),   -- azul
            ColorSequenceKeypoint.new(1, Color3.fromRGB(128, 0, 128))    -- roxo
        }),
        Rotation = 45
    })

    -- Função para ajustar brilho conforme estado
    local function UpdateRainbowAppearance(enabled)
        if enabled then
            -- Brilho normal (cores vibrantes)
            rainbowGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 165, 0)),
                ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(128, 0, 128))
            })
        else
            -- Desativado: cores escuras, mas mantendo tonalidade (sem luz forte)
            rainbowGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(80, 0, 0)),      -- vermelho escuro
                ColorSequenceKeypoint.new(0.2, Color3.fromRGB(80, 50, 0)),   -- laranja escuro
                ColorSequenceKeypoint.new(0.4, Color3.fromRGB(80, 80, 0)),   -- amarelo escuro
                ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 80, 0)),    -- verde escuro
                ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 0, 80)),    -- azul escuro
                ColorSequenceKeypoint.new(1, Color3.fromRGB(40, 0, 40))      -- roxo escuro
            })
        end
    end

    -- Define aparência inicial
    UpdateRainbowAppearance(Default)

    local WaitClick = false
    local function SetToggleState(state)
