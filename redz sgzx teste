local function GetFullPath(fileName)
    if type(fileName) ~= "string" then
        return fileName
    end
    -- Se jÃ¡ tiver barra, considera como caminho absoluto/relativo do executor
    if fileName:find("/") or fileName:find("\\") then
        return fileName
    end
    -- Caso contrÃ¡rio, coloca dentro da pasta da lib
    return LibFolder .. "/" .. fileName
end

