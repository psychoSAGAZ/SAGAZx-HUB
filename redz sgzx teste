    RunService.RenderStepped:Connect(function(dt)
        if not borderAnimationActive then return end
        if not ScreenGui.Hub then return end
        local mainStroke = ScreenGui.Hub:FindFirstChildOfClass("UIStroke")
        if not mainStroke then return end

        local timeElapsed = tick() * 1 -- animSpeed poderia ser configurável, mantemos 1
        local colorOpt = MyLibrary.Save.BorderColorOption
        local effectOpt = MyLibrary.Save.BorderEffectOption

        local baseColor
        if colorOpt == "RGB (Completo)" then
            baseColor = Color3.fromHSV((timeElapsed % 5) / 5, 1, 1)
        elseif colorOpt == "Vermelho" then
            baseColor = Color3.fromRGB(255, 0, 0)
        elseif colorOpt == "Laranja" then
            baseColor = Color3.fromRGB(255, 128, 0)
        elseif colorOpt == "Amarelo" then
            baseColor = Color3.fromRGB(255, 255, 0)
        elseif colorOpt == "Verde" then
            baseColor = Color3.fromRGB(0, 255, 0)
        elseif colorOpt == "Azul" then
            baseColor = Color3.fromRGB(0, 0, 255)
        elseif colorOpt == "Anil" then
            baseColor = Color3.fromRGB(75, 0, 130)
        elseif colorOpt == "Violeta" then
            baseColor = Color3.fromRGB(148, 0, 211)
        else
            baseColor = Color3.fromRGB(255, 255, 255)
        end

        if effectOpt == "Girar Gradiente" then
            if colorOpt == "RGB (Completo)" then
                mainStroke.Color = baseColor
            else
                local h, s, v = baseColor:ToHSV()
                local shiftedHue = (h + (math.sin(timeElapsed * 2) * 0.1)) % 1
                mainStroke.Color = Color3.fromHSV(shiftedHue, s, v)
            end
            mainStroke.Thickness = 2
        elseif effectOpt == "Pulsar Brilho" then
            mainStroke.Color = baseColor
            mainStroke.Thickness = math.clamp(2 + math.sin(timeElapsed * 4) * 1.5, 1, 4)
        elseif effectOpt == "Onda Fluida" then
            local h, s, v = baseColor:ToHSV()
            local waveVal = math.clamp(v * (0.5 + 0.5 * math.sin(timeElapsed * 3)), 0.2, 1)
            mainStroke.Color = Color3.fromHSV(h, s, waveVal)
            mainStroke.Thickness = 2.5
        elseif effectOpt == "Neon Strobe" then
            if math.floor(timeElapsed * 6) % 2 == 0 then
                mainStroke.Color = baseColor
                mainStroke.Thickness = 3
            else
                mainStroke.Color = Color3.fromRGB(30, 30, 35)
                mainStroke.Thickness = 1
            end
        elseif effectOpt == "Fade Suave" then
            local h, s, v = baseColor:ToHSV()
            local fadeFactor = 0.3 + 0.7 * math.abs(math.sin(timeElapsed * 1.5))
            mainStroke.Color = Color3.fromHSV(h, s, fadeFactor)
            mainStroke.Thickness = 2
        end
    end)

