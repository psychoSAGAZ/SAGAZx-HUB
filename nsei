local WORKER_URL = "https://transmissor.alancarlo626.workers.dev"
local POLL_INTERVALO = 3

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- ================= HTTP =================
local httpFn = nil
pcall(function() if request then httpFn = request end end)
pcall(function() if not httpFn and http_request then httpFn = http_request end end)

if not httpFn then
    warn("[Admin] Nenhuma função HTTP encontrada.")
    return
end

local function httpPost(url, body)
    local ok, res = pcall(function()
        return httpFn({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(body),
        })
    end)
    if ok and res and res.Body then
        local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if ok2 then return data end
    end
    return nil
end

local function httpGet(url)
    local ok, res = pcall(function()
        return httpFn({ Url = url, Method = "GET" })
    end)
    if ok and res and res.Body then
        local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if ok2 then return data end
    end
    return nil
end

