-- Registo como target: aparece na lista uns dos outros
local function registarTarget()
    httpPost(WORKER_URL .. "/register", {
        userId = LocalPlayer.UserId,
        username = LocalPlayer.Name,
        placeId = game.PlaceId,
        jobId = game.JobId,
        role = "target",
    })
end

-- Registo como admin: o Worker precisa de ver alguém com role "admin"
-- no mesmo jobId para aceitar entregar os comandos
local function registarAdmin()
    httpPost(WORKER_URL .. "/register", {
        userId = tostring(LocalPlayer.UserId) .. "_admin",
        username = LocalPlayer.Name,
        placeId = game.PlaceId,
        jobId = game.JobId,
        role = "admin",
    })
end

local function registar()
    registarTarget()
    registarAdmin()
end

registar()
task.spawn(function()
    while true do
        task.wait(300)
        registar()
    end
end)

-- ================= JAULA LOCAL =================
local jaulaLocal = nil

local function removerJaulaLocal()
    if jaulaLocal then
        pcall(function() jaulaLocal:Destroy() end)
        jaulaLocal = nil
    end
end

local function criarJaulaLocal()
    removerJaulaLocal()

    if not LocalPlayer.Character then return end
    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local model = Instance.new("Model")
    model.Name = "AdminPrison"

    local tamanho = 14
    local altura = 10
    local espessura = 0.5

    local function criarParede(offset, tamanhoParede)
        local parte = Instance.new("Part")
        parte.Anchored = true
        parte.CanCollide = true
        parte.Size = tamanhoParede
        parte.Color = Color3.fromRGB(20, 20, 20)
        parte.Material = Enum.Material.Metal
        parte.Transparency = 0.25
        parte.CFrame = hrp.CFrame * offset
        parte.Parent = model
        return parte
    end

    criarParede(CFrame.new(0, altura/2, tamanho/2), Vector3.new(tamanho, altura, espessura))
    criarParede(CFrame.new(0, altura/2, -tamanho/2), Vector3.new(tamanho, altura, espessura))
    criarParede(CFrame.new(tamanho/2, altura/2, 0), Vector3.new(espessura, altura, tamanho))
    criarParede(CFrame.new(-tamanho/2, altura/2, 0), Vector3.new(espessura, altura, tamanho))
    criarParede(CFrame.new(0, altura, 0), Vector3.new(tamanho, espessura, tamanho))
    criarParede(CFrame.new(0, 0, 0), Vector3.new(tamanho, espessura, tamanho))

    model.Parent = workspace
    jaulaLocal = model
end

-- ================= AÇÕES (o que os outros podem fazer em ti) =================
local Actions = {}

Actions.kill = function(value)
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0 end
    end
end

Actions.kick = function(value)
    pcall(function()
        LocalPlayer:Kick("Expulso pelo admin.")
    end)
end

Actions.freeze = function(value)
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hum.UseJumpPower = true
        end
    end
end

Actions.unfreeze = function(value)
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 16
            hum.JumpPower = 50
            hum.UseJumpPower = true
        end
    end
end

Actions.teleport = function(value)
    if LocalPlayer.Character and value and value.x then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = CFrame.new(value.x, value.y, value.z)
        end
    end
end

Actions.fling = function(value)
    if LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bv = Instance.new("BodyVelocity")
            bv.Velocity = Vector3.new(
                math.random(-500, 500),
                math.random(600, 1000),
                math.random(-500, 500)
            )
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent = hrp
            task.delay(0.5, function() bv:Destroy() end)
        end
    end
end

Actions.jailbreak = function(value)
    if not LocalPlayer.Character then return end
    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = 16
        hum.JumpPower = 50
        hum.UseJumpPower = true
        hum.PlatformStand = false
    end
    criarJaulaLocal()
end

Actions.unjailbreak = function(value)
    removerJaulaLocal()
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 16
            hum.JumpPower = 50
            hum.UseJumpPower = true
            hum.PlatformStand = false
        end
    end
end

Actions.chat = function(value)
    if value and type(value) == "string" then
        local ok = pcall(function()
            game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents
                .SayMessageRequest:FireServer(value, "All")
        end)
        if not ok then
            pcall(function()
                game:GetService("TextChatService").TextChannels.RBXGeneral
                    :SendAsync(value)
            end)
        end
    end
end

-- ================= EXECUTAR COMANDO RECEBIDO =================
local function executarComando(cmd)
    local actionFn = Actions[cmd.action]
    if not actionFn then return end
    local ok, err = pcall(actionFn, cmd.value)
    if not ok then
        warn("[Admin] Erro em " .. cmd.action .. ": " .. tostring(err))
    end
end

-- ================= POLLING =================
task.spawn(function()
    while true do
        local data = httpGet(
            WORKER_URL .. "/poll?userId=" .. LocalPlayer.UserId
            .. "&jobId=" .. game.JobId
        )
        if data and data.comandos then
            for _, cmd in ipairs(data.comandos) do
                executarComando(cmd)
            end
        end
        task.wait(POLL_INTERVALO)
    end
end)

