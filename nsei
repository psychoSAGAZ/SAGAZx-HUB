-- Jaulas visíveis no lado do admin: userId -> Model
local jaulasAdmin = {}

-- ================= HELPERS =================
local function jobIdLocal() return game.JobId end

local function estaNoServidor(userId)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.UserId == tonumber(userId) then
            return true
        end
    end
    return false
end

local function construirOptions()
    local opts = {}
    for _, t in ipairs(alvos) do
        table.insert(opts, t.username .. " (" .. t.userId .. ")")
    end
    return opts
end

local function atualizarDropdown()
    if aAtualizarDropdown then return end
    aAtualizarDropdown = true
    local opts = construirOptions()
    if alvoSelecionado then
        local aindaExiste = false
        for _, t in ipairs(alvos) do
            if t.userId == alvoSelecionado.userId then
                aindaExiste = true
                break
            end
        end
        if not aindaExiste then alvoSelecionado = nil end
    end
    pcall(function() Dropdown:Refresh(opts) end)
    aAtualizarDropdown = false
end

-- Lista alvos do Worker, excluindo-nos a nós mesmos
local function listarAlvos()
    local data = httpGet(WORKER_URL .. "/list?jobId=" .. jobIdLocal())
    if data and data.players then
        local filtrados = {}
        for _, t in ipairs(data.players) do
            if tostring(t.userId) ~= tostring(LocalPlayer.UserId)
               and estaNoServidor(t.userId) then
                table.insert(filtrados, t)
            end
        end
        alvos = filtrados
    else
        alvos = {}
    end
    return alvos
end

-- ================= JAULA (LADO ADMIN) =================
local function criarJaulaAdmin(userId)
    if jaulasAdmin[userId] then
        pcall(function() jaulasAdmin[userId]:Destroy() end)
        jaulasAdmin[userId] = nil
    end

    local alvoPlayer = Players:GetPlayerByUserId(tonumber(userId))
    if not alvoPlayer or not alvoPlayer.Character then return end

    local model = Instance.new("Model")
    model.Name = "AdminPrison_" .. userId

    local tamanho = 14
    local altura = 10
    local espessura = 0.5

    local function criarParede(posicaoRelativa, tamanhoParede)
        local parte = Instance.new("Part")
        parte.Anchored = true
        parte.CanCollide = false
        parte.Size = tamanhoParede
        parte.Color = Color3.fromRGB(20, 20, 20)
        parte.Material = Enum.Material.Metal
        parte.Transparency = 0.25
        parte.CanQuery = false
        parte.CanTouch = false
        parte.Parent = model
        return parte
    end

    local paredes = {}
    table.insert(paredes, { criarParede(nil, Vector3.new(tamanho, altura, espessura)), CFrame.new(0, altura/2, tamanho/2) })
    table.insert(paredes, { criarParede(nil, Vector3.new(tamanho, altura, espessura)), CFrame.new(0, altura/2, -tamanho/2) })
    table.insert(paredes, { criarParede(nil, Vector3.new(espessura, altura, tamanho)), CFrame.new(tamanho/2, altura/2, 0) })
    table.insert(paredes, { criarParede(nil, Vector3.new(espessura, altura, tamanho)), CFrame.new(-tamanho/2, altura/2, 0) })
    table.insert(paredes, { criarParede(nil, Vector3.new(tamanho, espessura, tamanho)), CFrame.new(0, altura, 0) })
    table.insert(paredes, { criarParede(nil, Vector3.new(tamanho, espessura, tamanho)), CFrame.new(0, 0, 0) })

    model.Parent = workspace
    jaulasAdmin[userId] = model

    task.spawn(function()
        while jaulasAdmin[userId] == model do
            local p = Players:GetPlayerByUserId(tonumber(userId))
            if p and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    for _, par in ipairs(paredes) do
                        local parte, offset = par[1], par[2]
                        parte.CFrame = hrp.CFrame * offset
                    end
                end
            else
                break
            end
            task.wait(0.05)
        end
    end)
end

local function removerJaulaAdmin(userId)
    if jaulasAdmin[userId] then
        pcall(function() jaulasAdmin[userId]:Destroy() end)
        jaulasAdmin[userId] = nil
    end
end

-- ================= ENVIAR COMANDO =================
local function enviarComando(action, value)
    if not alvoSelecionado then
        Window:Notification({
            Title = "Erro",
            Content = "Seleciona um jogador primeiro!",
            Icon = "alert-triangle",
            Duration = 3,
        })
        return
    end

    if not estaNoServidor(alvoSelecionado.userId) then
        Window:Notification({
            Title = "Erro",
            Content = "Esse jogador já saiu do servidor.",
            Icon = "x",
            Duration = 3,
        })
        removerJaulaAdmin(alvoSelecionado.userId)
        for i, t in ipairs(alvos) do
            if t.userId == alvoSelecionado.userId then
                table.remove(alvos, i)
                break
            end
        end
        alvoSelecionado = nil
        atualizarDropdown()
        return
    end

    local resultado = httpPost(WORKER_URL .. "/command", {
        targetUserId = alvoSelecionado.userId,
        action = action,
        value = value,
        fromAdmin = LocalPlayer.Name,
        adminJobId = jobIdLocal(),
    })

    if resultado and resultado.ok then
        Window:Notification({
            Title = "Comando Enviado",
            Content = action .. " → " .. alvoSelecionado.username,
            Icon = "check",
            Duration = 2,
        })

        if action == "jailbreak" then
            criarJaulaAdmin(alvoSelecionado.userId)
        elseif action == "unjailbreak" then
            removerJaulaAdmin(alvoSelecionado.userId)
        end
    else
        Window:Notification({
            Title = "Falha",
            Content = "Não foi possível enviar o comando.",
            Icon = "x",
            Duration = 3,
        })
    end
end

