                        local srcInHotbar = getHotbarIndexFromButton(b)
                        if srcInHotbar then
                            hotbarSlots[srcInHotbar] = nil
                            table.insert(inventorySlots, sourceTool)
                        end
                    end
                    
                    draggingButton = nil
                    dragSessionId = dragSessionId + 1
                    rebuild()
                end
            end
        end)
    end
end)

return b;
