local conns = {};
local tConns = {};
local function attachToolSignals(t)
if not t or (not t:IsA("Tool")) then return end;
if tConns[t] then
for _, c in tConns[t] do if c and c.Disconnect then c:Disconnect() end end
end;
tConns[t] = {};
table.insert(tConns[t], t.Equipped:Connect(function() sel = t; qreq() end));
table.insert(tConns[t], t.Unequipped:Connect(function() if sel == t then sel = nil; qreq() end end));
table.insert(tConns[t], t.AncestryChanged:Connect(function()
if t.Parent == Plr.Character then sel = t; qreq()
elseif sel == t and t.Parent ~= Plr.Character then sel = nil; qreq() end
end));
end;

local function hook()
for _, c in conns do if c and c.Disconnect then c:Disconnect() end end
table.clear(conns);
local bp = Plr:FindFirstChild("Backpack");
if bp then
for _, t in bp:GetChildren() do attachToolSignals(t) end;
table.insert(conns, bp.ChildAdded:Connect(function(ch) attachToolSignals(ch); qreq() end));
table.insert(conns, bp.ChildRemoved:Connect(function(ch)
if ch == sel then sel = nil end; qreq()
end));
end;
if Plr.Character then
for _, t in Plr.Character:GetChildren() do attachToolSignals(t) end;
table.insert(conns, Plr.Character.ChildAdded:Connect(function(ch) attachToolSignals(ch); qreq() end));
table.insert(conns, Plr.Character.ChildRemoved:Connect(function(ch)
if ch == sel then sel = nil end; qreq()
end));
end;
end;

Plr.CharacterAdded:Connect(function() task.wait(0.1); qreq(); hook() end);
hook();
rebuild();

