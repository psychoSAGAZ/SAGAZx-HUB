        [Enum.KeyCode.Zero] = 10
    };
    local idx = map[kc];
    if idx then
        local t = hotbarSlots[idx]
        if t then
            tog(t);
            qreq();
        end;
    end;
    if kc == Enum.KeyCode.Backquote then
        setInventoryState(not exp)
    end;
end);

