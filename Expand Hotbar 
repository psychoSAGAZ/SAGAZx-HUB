                    local droppedInScr = (endPos.X >= srcMin.X and endPos.X <= srcMax.X and endPos.Y >= srcMin.Y and endPos.Y <= srcMax.Y)
                    
                    if targetBtn and targetBtn ~= b then
                        local targetTool = tBtns[targetBtn]
                        local srcInHotbar = getHotbarIndexFromButton(b)
                        local srcInInv = getInventoryIndexFromButton(b)
                        local tgtInHotbar = getHotbarIndexFromButton(targetBtn)
                        local tgtInInv = getInventoryIndexFromButton(targetBtn)
                        
                        if srcInHotbar and tgtInHotbar then
                            hotbarSlots[srcInHotbar] = targetTool
                            hotbarSlots[tgtInHotbar] = sourceTool
                        elseif srcInHotbar and tgtInInv then
                            hotbarSlots[srcInHotbar] = targetTool
                            inventorySlots[tgtInInv] = sourceTool
                        elseif srcInInv and tgtInHotbar then
                            inventorySlots[srcInInv] = targetTool
                            hotbarSlots[tgtInHotbar] = sourceTool
                        elseif srcInInv and tgtInInv then
                            inventorySlots[srcInInv] = targetTool
                            inventorySlots[tgtInInv] = sourceTool
                        end
                    elseif targetEmptySlotIndex then
                        local srcInHotbar = getHotbarIndexFromButton(b)
                        local srcInInv = getInventoryIndexFromButton(b)
                        
                        if srcInHotbar then
                            hotbarSlots[srcInHotbar] = nil
                        elseif srcInInv then
                            table.remove(inventorySlots, srcInInv)
                        end
                        hotbarSlots[targetEmptySlotIndex] = sourceTool
