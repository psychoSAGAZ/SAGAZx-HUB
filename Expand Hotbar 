UIS.InputBegan:Connect(function(i, gp)
    local kc = i.KeyCode;
    
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        if exp then
            local pos = i.Position
            if pos.Y <= 48 then return end
            
            local bMin = bar.AbsolutePosition
            local bMax = bMin + bar.AbsoluteSize
            local eMin = expFr.AbsolutePosition
            local eMax = eMin + expFr.AbsoluteSize
            
            local clickedInBar = (pos.X >= bMin.X and pos.X <= bMax.X and pos.Y >= bMin.Y and pos.Y <= bMax.Y)
            local clickedInExp = (pos.X >= eMin.X and pos.X <= eMax.X and pos.Y >= eMin.Y and pos.Y <= eMax.Y)
            
            if not clickedInBar and not clickedInExp then
                setInventoryState(false)
                return
            end
        end
    end

    if gp or mob then return end;
    
    local map = {
