    if hotbarSlots[i] and not currentTools[hotbarSlots[i]] then
        hotbarSlots[i] = nil
    end
end
for i = #inventorySlots, 1, -1 do
    local t = inventorySlots[i]
    if t and not currentTools[t] then
        table.remove(inventorySlots, i)
    end
end

for t, _ in pairs(currentTools) do
    local achou = false
    for i = 1, maxHotbarSlots do
        if hotbarSlots[i] == t then achou = true break end
    end
    if not achou then
        if table.find(inventorySlots, t) then achou = true end
    end
    
    if not achou then
        local alocado = false
        for i = 1, maxHotbarSlots do
            if not hotbarSlots[i] then
                hotbarSlots[i] = t
                alocado = true
                break
            end
        end
        if not alocado then
            table.insert(inventorySlots, t)
        end
    end
end

