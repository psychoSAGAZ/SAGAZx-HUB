                    dragGhost.ZIndex = 1000
                    dragGhost.BackgroundTransparency = 0.4
                    dragGhost.Parent = ui
                    if dragGhost:FindFirstChild("Key") then dragGhost.Key:Destroy() end
                    b.BackgroundTransparency = 0.7
                end
                
                if isDragMode and dragGhost then
                    dragGhost.Position = UDim2.fromOffset(changedInput.Position.X, changedInput.Position.Y)
                end
            end
        end)
        
        local endConn
        endConn = UIS.InputEnded:Connect(function(endedInput)
            if endedInput.UserInputType == Enum.UserInputType.MouseButton1 or endedInput.UserInputType == Enum.UserInputType.Touch then
                endConn:Disconnect()
                if currentSession ~= dragSessionId then return end
                if dragInputConn then dragInputConn:Disconnect() dragInputConn = nil end
                
                if not isDragMode then
                    dragSessionId = dragSessionId + 1
                    tog(t)
                    rebuild()
                else
                    if dragGhost then dragGhost:Destroy() dragGhost = nil end
                    b.BackgroundTransparency = 1
                    
                    local endPos = endedInput.Position
