local function GetCatalogHumanoid()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") then
            local model = obj.Parent
            if model
            and model ~= LocalPlayer.Character
            and model:FindFirstChild("HumanoidRootPart")
